{
  "name": "ianwremmel.com",
  "description": "Personal website of Ian W. Remmel",
  "version": "3.0.0",
  "author": "Ian Remmel <1182361+ianwremmel@users.noreply.github.com>",
  "keywords": [],
  "license": "MIT",
  "scripts": {
    "build": "npm-run-all build:graphql build:styles build:assets",
    "build:assets": "esbuild app/assets/entry.ts --bundle --format=esm --platform=browser --define:process.env.NODE_ENV=\\\"production\\\" --minify --outfile=public/assets/entry.js",
    "build:graphql": "graphql-codegen --config codegen.yml --require dotenv/config",
    "build:styles": "sass --load-path . app/styles/index.scss public/root.css",
    "dev": "npm-run-all --continue-on-error --parallel dev:*",
    "dev:assets": "esbuild app/assets/entry.ts --bundle --format=esm --platform=browser --define:process.env.NODE_ENV=\\\"development\\\" --outfile=public/assets/entry.js --watch",
    "dev:css": "sass --load-path . app/styles/index.scss public/root.css --watch",
    "dev:server": "node --watch --import remix/node-tsx server.ts",
    "start": "node --import remix/node-tsx server.ts",
    "eslint": "eslint ${ESLINT_FORMAT_OPTIONS:-} --ignore-path .gitignore ",
    "lint": "npm-run-all --continue-on-error --parallel lint:*",
    "lint:changelog": "commitlint --from origin/main --to HEAD",
    "prelint:es": "mkdirp reports/style",
    "lint:es": "npm run --silent eslint -- .",
    "prelint:types": "mkdirp reports/style",
    "lint:types": "tsc --noEmit",
    "prepare": "husky install",
    "test": "node --import remix/node-tsx --test"
  },
  "type": "module",
  "devDependencies": {
    "@commitlint/cli": "^18.2.0",
    "@commitlint/config-conventional": "^18.1.0",
    "@graphql-codegen/cli": "^5.0.0",
    "@graphql-codegen/introspection": "^4.0.0",
    "@graphql-codegen/schema-ast": "^4.0.0",
    "@graphql-codegen/typescript": "^4.0.1",
    "@graphql-codegen/typescript-operations": "^4.0.1",
    "@graphql-codegen/typescript-urql": "^4.0.0",
    "@ianwremmel/eslint-plugin-ianwremmel": "^6.2.2",
    "@types/node": "^24.0.0",
    "dotenv": "^16.3.1",
    "esbuild": "^0.24.2",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^8.0.3",
    "lint-staged": "^15.0.2",
    "markdown-toc": "^1.2.0",
    "mkdirp": "^3.0.1",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.0.3",
    "sass": "^1.69.5",
    "typescript": "^5.6.0"
  },
  "private": true,
  "lint-staged": {
    "*.js": "npm run eslint -- ",
    "*.ts": "npm run eslint -- ",
    "*.tsx": "npm run eslint -- "
  },
  "husky": {
    "hooks": {
      "commit-msg": "commitlint -e",
      "pre-commit": "lint-staged"
    }
  },
  "engines": {
    "node": ">=24.3.0"
  },
  "sideEffects": false,
  "dependencies": {
    "@urql/core": "^4.1.4",
    "bootstrap": "^5.1.3",
    "graphql": "^16.8.1",
    "rehype-stringify": "^10.0.0",
    "remark-gfm": "^4.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.0.0",
    "remix": "^3.0.0-beta.3",
    "unified": "^11.0.4"
  }
}
